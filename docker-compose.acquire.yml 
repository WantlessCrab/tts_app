# docker-compose.acquire.yml

services:
  acquire-service:
    build:
      context: .
      dockerfile: dockerfile.acquire
    container_name: project-rebuild-acquire
    restart: unless-stopped
    ports:
      - "8005:8000"
    volumes:
      - ./my_app:/app
      - ./my_app/static:/app/static
      - ./pdf_input:/workspace/pdf_input:ro
      - ./outputs:/workspace/outputs
      - ./pdf_cache:/workspace/pdf_cache
    environment:
      - PYTHONUNBUFFERED=1
      - PDF_SERVICE_URL=http://host.docker.internal:8001
      - DOCTR_SERVICE_URL=http://host.docker.internal:8004
      - CONVERT_SERVICE_URL=http://host.docker.internal:8006
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - main-app-network

networks:
  main-app-network:
    external: true