# dockerfile.doctr
# === Stage 1: The Base Image ===
# INHERIT from our "Gold Standard" GPU base - provides Ubuntu, Python, ROCm, and PyTorch.
FROM project-rebuild-gold-standard:latest
# === Stage 2: System Setup ===
# The base image already set the WORKDIR to /app
# WORKDIR /app
# === Stage 3: Install Dependencies ===
# System libraries required by opencv-python (docTR core dep)
# libgl1 + libglib2.0-0: headless container requirements
# libsm6 + libxext6: confirmed by docTR API Dockerfile
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*
# Copy *only* the requirements file first
COPY requirements.doctr.txt .
# Install this service's specific dependencies
RUN pip install --no-cache-dir -r requirements.doctr.txt
# === Stage 3.5: docTR OCR Engine (contamination-shielded install) ===
# torchvision is a core dep of python-doctr but NOT in the base image.
# Plain pip resolves from PyPI default index (CPU-only build).
# Must install from ROCm index first to protect ROCm torch stack.
RUN pip3 install --no-cache-dir torchvision --no-deps \
    --index-url https://download.pytorch.org/whl/rocm6.4
# --no-deps: all core deps already installed via requirements.doctr.txt above
# Without --no-deps, pip re-resolves torch+torchvision from PyPI default index
RUN pip3 install --no-cache-dir python-doctr --no-deps
# Verification 1: ROCm runtime present
RUN python3 -c "\
import torch; \
print(f'Torch: {torch.__version__}'); \
print(f'HIP: {torch.version.hip}'); \
assert torch.version.hip is not None, 'ROCm runtime missing — build failed.'"
# Verification 2: docTR imports cleanly
RUN python3 -c "import doctr; print('docTR import successful')"
# === Stage 4: Copy Application Code ===
COPY my_app/doctr_service.py .
# === Stage 5: Define Runtime Command ===
EXPOSE 8000
CMD ["uvicorn", "doctr_service:app", "--host", "0.0.0.0", "--port", "8000"]