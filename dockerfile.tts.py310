# ========================================
# 1. THE BASE IMAGE (OUR "GOLDEN TEMPLATE")
# ========================================
# Inherits the OS, Python, PyTorch (ROCm), and Numpy
FROM project-rebuild-gold-standard:latest

# ========================================
# 2. THE "APPLICATION LAYER" (TTS SERVICE)
# ========================================

# --- 1. Install System Dependencies ---
#
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    libsndfile1-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Install Python Dependencies (Proven Legacy Method) ---

# 1. Copy the "safe" (and now Py3.12-compatible) requirements file
COPY requirements-rocm-clean.txt .

# 2. Install all "safe" packages from your list.
#
RUN pip3 install --no-cache-dir -r requirements-rocm-clean.txt

# 3. Install "problematic" packages separately
#
RUN pip3 install --no-cache-dir transformers>=4.33.0 --no-deps

# 4. Manually install transformers' sub-dependencies
#
RUN pip3 install --no-cache-dir \
    tokenizers \
    huggingface-hub \
    safetensors \
    regex \
    requests \
    filelock \
    typing-extensions

# 5. Install other "problematic" packages
# --- THIS LINE IS THE FIX for our last build failure ---
#
# RUN pip3 install --no-cache-dir trainer>=0.0.36 --no-deps

# --- 3. Install TTS from Local Source (The "Aha!" Moment) ---
#
COPY . /workspace/
WORKDIR /workspace

# 1. Remove the version check condition
RUN sed -i 's/or Version(python_version) >= Version("3.12")//g' setup.py

# 2. Fix the error message
RUN sed -i 's/and < 3.12 //g' setup.py

# 3. Fix python_requires - note the space after comma!
RUN sed -i 's/>=3.9.0, <3.12/>=3.9.0/g' setup.py

RUN ln -s requirements-rocm-clean.txt requirements.txt

RUN pip3 install --no-cache-dir -e .

# --- 4. Verify the ROCm Stack Survived ---
#.
RUN python3 -c "import torch; print(f'Torch: {torch.__version__}'); assert 'rocm' in torch.__version__, 'ROCm-enabled PyTorch was overwritten! Build failed.'" && \
    pip3 list | grep -i nvidia && echo "ERROR: NVIDIA packages found!" && exit 1 || echo "✓ No NVIDIA contamination"

# --- 5. Finalize Container ---
WORKDIR /app
RUN mkdir -p /root/.local/share/tts

# 6. Define Runtime Defaults
EXPOSE 8000
CMD ["python3", "-m", "TTS.server.server", "--model_name", "tts_models/en/ljspeech/tacotron2-DDC", "--host", "0.0.0.0", "--port", "8000"]