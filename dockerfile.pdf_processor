# dockerfile.pdf_processor

# === Stage 1: The Base Image ===
# INHERIT from our "Gold Standard" GPU base - provides Ubuntu, Python, ROCm, and PyTorch.
FROM project-rebuild-gold-standard:latest

# === Stage 2: System Setup ===
# The base image already set the WORKDIR to /app
# WORKDIR /app

# === Stage 3: Install Dependencies ===
# Copy *only* the requirements file first
COPY requirements.pdf_processor.txt .

# Install this service's specific dependencies
RUN pip install --no-cache-dir -r requirements.pdf_processor.txt

# === Stage 4: Copy Application Code ===
# Copy the Python file that contains the FastAPI app
COPY my_app/pdf_processor/process.py .

# === Stage 5: Define Runtime Command ===
# Expose port 8000 (the default for FastAPI)
EXPOSE 8000

# Run the Uvicorn server, pointing to the 'app' object in 'process.py'
CMD ["uvicorn", "process:app", "--host", "0.0.0.0", "--port", "8000"]