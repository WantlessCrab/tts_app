# Dockerfile.relay

# ========================================
# 1. THE BASE IMAGE (CPU-Only)
# ========================================
# Matching your template: Minimal, official Python 3.12 image
FROM python:3.12-slim

# ========================================
# 2. THE "APPLICATION LAYER"
# ========================================

# 1. System Config
# Prevent Python from buffering stdout/stderr (Standard log config)
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# 2. Application Dependencies
# Unlike the file server (which uses built-in libs), we need the API server framework.
# We install these directly to keep the footprint small.
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    requests

# 3. Set the working directory
# We map the backend code directly to /app
WORKDIR /app

# 4. Expose the Service Port
# Using 8005 to avoid conflict with PDF (8001) and TTS (8002)
EXPOSE 8005

# 5. Run the ASGI Server (Uvicorn)
# Pointing to 'router:app' assuming router.py is mounted in /app
CMD ["uvicorn", "router:app", "--host", "0.0.0.0", "--port", "8005", "--reload"]