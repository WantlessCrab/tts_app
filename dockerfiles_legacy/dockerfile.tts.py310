# dockerfile.tts.py310

# ========================================
# 1. THE BASE IMAGE (OUR "GOLDEN TEMPLATE" PY3.10)
# ========================================
# This is our new, compatible Py3.10 base
FROM project-rebuild-gold-standard-py310:latest

# ========================================
# 2. THE "APPLICATION LAYER" (TTS SERVICE)
# ========================================

# --- 1. Install System Dependencies ---
# These are the audio packages from your working legacy Dockerfile
#
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    libsndfile1-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Install Python Dependencies (Proven Legacy Method) ---

# 1. Copy the "safe" requirements file
COPY requirements-rocm-clean.txt .

# 2. Install all packages. These will all work
#    because we are on Python 3.10.
#
RUN pip3 install --no-cache-dir -r requirements-rocm-clean.txt

# 3. Install "problematic" packages separately, as per legacy file
#
RUN pip3 install --no-cache-dir transformers>=4.33.0 --no-deps

# 4. Manually install transformers' sub-dependencies (from legacy file)
#
RUN pip3 install --no-cache-dir \
    tokenizers \
    huggingface-hub \
    safetensors \
    regex \
    requests \
    filelock \
    typing-extensions

# 5. Install trainer (this will work now on Py3.10)
#
RUN pip3 install --no-cache-dir trainer>=0.0.36 --no-deps

# --- 3. Install TTS from Local Source ---
# This replicates the logic from your legacy file
COPY . /workspace/
WORKDIR /workspace

RUN ln -s requirements-rocm-clean.txt requirements.txt

# We can now run this command *without* any patches
RUN pip3 install --no-cache-dir -e .

# --- 4. Verify the ROCm Stack Survived ---
#.
RUN python3 -c "import torch; print(f'Torch: {torch.__version__}'); assert 'rocm' in torch.__version__, 'ROCm-enabled PyTorch was overwritten! Build failed.'" && \
    pip3 list | grep -i nvidia && echo "ERROR: NVIDIA packages found!" && exit 1 || echo "✓ No NVIDIA contamination"

# --- 5. Finalize Container ---
WORKDIR /app
RUN mkdir -p /root/.local/share/tts

# 6. Define Runtime Defaults
EXPOSE 8000
CMD ["python3", "-m", "TTS.server.server", "--model_name", "tts_models/en/ljspeech/tacotron2-DDC", "--host", "0.0.0.0", "--port", "8000"]