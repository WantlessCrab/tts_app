# dockerfile.base.py310
# 1. THE BASE IMAGE
FROM rocm/pytorch:rocm6.4.2_ubuntu22.04_py3.10_pytorch_release_2.6.0

# ----------------------------------------------------------------------
# 2. CORE STACK
# ----------------------------------------------------------------------

ENV DEBIAN_FRONTEND=noninteractive

# Install base build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# --- PyTorch & Dependencies  ---

# 1. NumPy - might work with 1.26.4, but 1.24.3 is safer for Python 3.10
RUN pip3 install --no-cache-dir numpy==1.24.3

RUN pip3 install --no-cache-dir \
    torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/rocm6.4 \
    --break-system-packages

# 2. "Checkmate Fix" (Build-Time)

RUN TORCH_LIB_PATH=$(python3 -c 'import torch; import os; print(os.path.join(os.path.dirname(torch.__file__), "lib"))') && \
    rm -f "${TORCH_LIB_PATH}/libhsa-runtime64.so"*

# ----------------------------------------------------------------------
# 3. BASE LAYER CONFIG
# ----------------------------------------------------------------------

# Use our standard project workdir
WORKDIR /app