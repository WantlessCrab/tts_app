# dockerfile.convert

# === Stage 1: Base Image ===
FROM python:3.12-slim-bookworm

# === Stage 2: System Setup ===
WORKDIR /app
ENV PATH="/opt/calibre/bin:$PATH"
ENV QT_QPA_PLATFORM=offscreen
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV QTWEBENGINE_DISABLE_SANDBOX=1
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# === Stage 3: System Dependencies ===
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libcairo2 \
    libcairo2-dev \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    shared-mime-info \
    ca-certificates \
    libgl1 \
    libegl1 \
    libopengl0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libasound2 \
    libx11-6 \
    libxext6 \
    libdbus-1-3 \
    libmagic1 \
    libmagic-dev \
    fontconfig \
    fonts-liberation \
    fonts-dejavu \
    wget \
    curl \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# === Stage 4: LibreOffice — pinned .deb install ===
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

# === Stage 5: Calibre ===
RUN wget -nv -O- https://download.calibre-ebook.com/linux-installer.sh \
    | sh /dev/stdin install_dir=/opt/calibre

# === Stage 6: Python Dependencies ===
COPY requirements.convert.txt .
RUN pip install --no-cache-dir -r requirements.convert.txt

# === Stage 7: Application Code ===
COPY my_app/convert/ ./convert/

# === Stage 8: Runtime ===
EXPOSE 8000
CMD ["uvicorn", "convert.api:app", "--host", "0.0.0.0", "--port", "8000"]