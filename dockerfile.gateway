# dockerfile.gateway

# === Stage 1: The Base Image ===
# Use a minimal, official Python 3.12 image. This is CPU-only.
FROM python:3.12-slim

# === Stage 2: System Setup ===
# Create a standard /app working directory
WORKDIR /app

# === Stage 3: Install Dependencies ===
# Copy *only* the requirements file first to leverage Docker's cache
COPY requirements.gateway.txt .

# Install the dependencies
RUN pip install --no-cache-dir -r requirements.gateway.txt

# === Stage 4: Copy Application Code ===
# Copy the server, static JS, and HTML templates
COPY my_app/audio_server.py .
COPY my_app/gateway_contracts.py .
COPY my_app/gateway_clients.py .
COPY my_app/gateway_router.py .
COPY my_app/static/ ./static/
COPY my_app/templates/ ./templates/

# === Stage 5: Define Runtime Command ===
# Expose port 8000 (the default for FastAPI)
EXPOSE 8000

# Run the Uvicorn server
# This will run 'python -m uvicorn audio_server:app ...'
CMD ["uvicorn", "audio_server:app", "--host", "0.0.0.0", "--port", "8000"]