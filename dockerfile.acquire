# dockerfile.acquire

# === Stage 1: Base Image ===
FROM python:3.12-slim

# === Stage 2: System Setup ===
WORKDIR /app

# === Stage 3: System Dependencies ===
# Playwright Chromium runtime deps
# Camoufox Firefox runtime deps
# libmagic1 + libmagic-dev for python-magic C binding
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && apt-get install -y \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxfixes3 \
    libatk1.0-0 \
    libcups2 \
    libxkbcommon0 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libgtk-3-0 \
    libx11-xcb1 \
    libdbus-glib-1-2 \
    libmagic1 \
    libmagic-dev \
    && rm -rf /var/lib/apt/lists/*

# === Stage 4: Python Dependencies ===
COPY requirements.acquire.txt .
RUN pip install --no-cache-dir -r requirements.acquire.txt

# === Stage 5: Playwright Chromium install ===
# install-deps removed — system deps already installed above
RUN playwright install chromium

# === Stage 6: Camoufox Firefox binary fetch ===
RUN python -m camoufox fetch

# === Stage 7: Bundle Readability JS ===
COPY my_app/static/Readability.js ./static/Readability.js

# === Stage 8: Application Code ===
COPY my_app/acquire_service.py .

# === Stage 9: Runtime ===
EXPOSE 8000
CMD ["uvicorn", "acquire_service:app", "--host", "0.0.0.0", "--port", "8000"]