# dockerfile.acquire

# === Stage 1: Base Image ===
FROM python:3.12-slim-bookworm

# === Stage 2: System Setup ===
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV PYTHONUNBUFFERED=1

# === Stage 3: System Dependencies ===
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libdrm2 \
    libgbm1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxfixes3 \
    libxkbcommon0 \
    libx11-6 \
    libx11-xcb1 \
    libxext6 \
    libegl1 \
    libopengl0 \
    libgl1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libcups2 \
    libmagic1 \
    libmagic-dev \
    ca-certificates \
    fontconfig \
    fonts-liberation \
    fonts-dejavu \
    curl \
    wget \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# === Stage 4: Python Dependencies ===
COPY requirements.acquire.txt .
RUN pip install --no-cache-dir -r requirements.acquire.txt

# === Stage 5: Playwright Chromium install ===
RUN playwright install chromium

# === Stage 6: Camoufox Firefox binary fetch ===
RUN python3 -m camoufox fetch

# === Stage 7: Bundle Readability JS ===
COPY my_app/static/Readability.js ./static/Readability.js

# === Stage 8: Application Code ===
COPY my_app/acquire/ ./acquire/

# === Stage 9: Runtime ===
EXPOSE 8000
CMD ["uvicorn", "acquire.api:app", "--host", "0.0.0.0", "--port", "8000"]